<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="520.0" style="-fx-background-color: #242424;" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <HBox fx:id="playlistHeader" alignment="CENTER" prefHeight="61.0" prefWidth="500.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="skipLeft" mnemonicParsing="false" styleClass="arrowLeft">
               <HBox.margin>
                  <Insets right="10.0" />
               </HBox.margin></Button>
            <Label fx:id="playlistName" alignment="CENTER" contentDisplay="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="-Infinity" text="playlist" textAlignment="CENTER">
               <font>
                  <Font name="Roboto Light" size="20.0" />
               </font></Label>
            <Button fx:id="skipRight" mnemonicParsing="false" styleClass="arrowRight">
               <HBox.margin>
                  <Insets left="10.0" />
               </HBox.margin></Button>
         </children>
      </HBox>
   </top>
   <center>
      <ListView fx:id="listView" editable="true" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: #2a2a2a;" BorderPane.alignment="CENTER" />
   </center>
   <bottom>
      <GridPane fx:id="playlistGrid" BorderPane.alignment="CENTER">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <HBox fx:id="playlistBottom" alignment="CENTER_RIGHT" prefHeight="89.0" prefWidth="500.0" GridPane.rowIndex="1">
               <children>
                  <Button fx:id="goBack" alignment="CENTER" mnemonicParsing="false" text="Back">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </Button>
               </children>
               <GridPane.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </GridPane.margin>
               <padding>
                  <Insets bottom="40.0" top="10.0" />
               </padding>
            </HBox>
            <Label fx:id="currentSong" text="">
               <GridPane.margin>
                  <Insets left="10.0" />
               </GridPane.margin>
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </GridPane>
   </bottom>
</BorderPane>
