<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="520.0" style="-fx-background-color: #242424;" xmlns="http://javafx.com/javafx/11.0.2" xmlns:fx="http://javafx.com/fxml/1">
   <top>
      <HBox alignment="CENTER_RIGHT" prefHeight="66.0" prefWidth="500.0" style="-fx-background-color: #1f1f1f;" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="goBack" mnemonicParsing="false" text="Back">
               <HBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </HBox.margin>
            </Button>
         </children>
         <opaqueInsets>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </opaqueInsets>
      </HBox>
   </top>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <CheckBox fx:id="darkTheme" mnemonicParsing="false" text="Dark Theme" textFill="WHITE">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
               <font>
                  <Font size="14.0" />
               </font></CheckBox>
            <CheckBox fx:id="brightTheme" mnemonicParsing="false" text="Bright Theme" textFill="WHITE">
               <font>
                  <Font size="14.0" />
               </font></CheckBox>
            <Label text="You need to restart the MP3 player to update the changes" textFill="#cdcdcd">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Label>
            <Label text="Choose your Music Directory" textFill="WHITE">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
               <font>
                  <Font size="15.0" />
               </font></Label>
            <GridPane>
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="215.0" minWidth="10.0" prefWidth="72.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="368.0" minWidth="10.0" prefWidth="368.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <TextField fx:id="musicDirectory" prefHeight="25.0" prefWidth="368.0" GridPane.columnIndex="1" />
                  <Button fx:id="browseButton" mnemonicParsing="false" prefHeight="25.0" prefWidth="76.0" text="browse" />
               </children>
            </GridPane>
            <Button fx:id="saveButton" mnemonicParsing="false" text="Save">
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </Button>
         </children>
         <BorderPane.margin>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
         </BorderPane.margin>
      </VBox>
   </center>
   <bottom>
      <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" BorderPane.alignment="BOTTOM_RIGHT">
         <image>
            <Image url="@../assets/img/djCat.png" />
         </image>
         <BorderPane.margin>
            <Insets bottom="40.0" right="40.0" />
         </BorderPane.margin>
      </ImageView>
   </bottom>
</BorderPane>
